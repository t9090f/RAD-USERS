<%- include('../partials/header', { title: title }) %>

<div class="row">
  <div class="col-md-12 mb-4">
    <div class="card shadow">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h3 class="mb-0">إدارة المستخدمين</h3>
        <a href="/admin/dashboard" class="btn btn-light btn-sm">العودة للوحة التحكم</a>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-4">
          <a href="/admin/users/new" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> إضافة مستخدم جديد
          </a>
        </div>
        
        <% if (users && users.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-striped" id="usersTable">
              <thead>
                <tr>
                  <th>الاسم</th>
                  <th>الاسم العربي</th>
                  <th>الاسم الإنجليزي</th>
                  <th>البريد الإلكتروني</th>
                  <th>البريد الإلكتروني للعمل</th>
                  <th>رقم الهوية</th>
                  <th>الجنسية</th>
                  <th>الجنس</th>
                  <th>تاريخ الميلاد</th>
                  <th>رقم الهاتف</th>
                  <th>العنوان</th>
                  <th>التخصص</th>
                  <th>المسمى الوظيفي</th>
                  <th>رقم الموظف</th>
                  <th>القسم</th>
                  <th>العمل الحالي</th>
                  <th>تاريخ التعيين</th>
                  <th>رقم التصنيف المهني</th>
                  <th>تاريخ انتهاء التصنيف</th>
                  <th>الدور</th>
                  <th>الحالة</th>
                  <th>تاريخ التسجيل</th>
                  <th>إجراءات</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(user => { %>
                  <tr>
                    <td><%= user.name || '-' %></td>
                    <td><%= user.arabicName || '-' %></td>
                    <td><%= user.englishName || '-' %></td>
                    <td><%= user.email || '-' %></td>
                    <td><%= user.workEmail || '-' %></td>
                    <td><%= user.civilId || '-' %></td>
                    <td><%= user.nationality || '-' %></td>
                    <td><%= user.gender || '-' %></td>
                    <td><%= user.birthDate ? new Date(user.birthDate).toLocaleDateString('ar-EG') : '-' %></td>
                    <td><%= user.phone || '-' %></td>
                    <td><%= user.address || '-' %></td>
                    <td><%= user.specialization || '-' %></td>
                    <td><%= user.jobTitle || '-' %></td>
                    <td><%= user.employeeId || '-' %></td>
                    <td><%= user.department || '-' %></td>
                    <td><%= user.currentWork || '-' %></td>
                    <td><%= user.hiringDate ? new Date(user.hiringDate).toLocaleDateString('ar-EG') : '-' %></td>
                    <td><%= user.professionalClassificationId || '-' %></td>
                    <td><%= user.professionalClassificationExpiryDate ? new Date(user.professionalClassificationExpiryDate).toLocaleDateString('ar-EG') : '-' %></td>
                    <td>
                      <% if (user.role === 'admin') { %>
                        <span class="badge bg-warning">مدير</span>
                      <% } else if (user.role === 'manager') { %>
                        <span class="badge bg-info">مشرف</span>
                      <% } else { %>
                        <span class="badge bg-success">مستخدم</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (user.isVerified) { %>
                        <span class="badge bg-success">مفعل</span>
                      <% } else { %>
                        <span class="badge bg-danger">غير مفعل</span>
                      <% } %>
                    </td>
                    <td><%= new Date(user.createdAt).toLocaleDateString('ar-EG') %></td>
                    <td>
                      <div class="btn-group" role="group">
                        <a href="/admin/users/<%= user._id.toString() %>" class="btn btn-sm btn-info">عرض</a>
                        <form action="/admin/users/<%= user._id.toString() %>/delete" method="POST" class="delete-user-form">
                          <button type="submit" class="btn btn-sm btn-danger" <%= (locals.user && locals.user.id && user._id.toString() === locals.user.id) ? 'disabled' : '' %>>حذف</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          
          <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <button type="button" class="btn btn-success" onclick="exportTableToExcel('usersTable', 'users')">
              <i class="fas fa-file-excel"></i> تصدير إلى Excel
            </button>
          </div>

          <% if (totalPages && totalPages > 1) { %>
            <nav aria-label="صفحات المستخدمين">
              <ul class="pagination justify-content-center mt-3">
                <% for(let i = 1; i <= totalPages; i++) { %>
                  <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>

          <script>
            function exportTableToExcel(tableID, filename = '') {
              var downloadLink;
              var dataType = 'application/vnd.ms-excel';
              var tableSelect = document.querySelector('table');
              var tableHTML = tableSelect.outerHTML.replace(/ /g, '%20');

              filename = filename ? filename + '.xls' : 'excel_data.xls';

              downloadLink = document.createElement('a');
              document.body.appendChild(downloadLink);

              if (navigator.msSaveOrOpenBlob) {
                var blob = new Blob(['\ufeff', tableHTML], { type: dataType });
                navigator.msSaveOrOpenBlob(blob, filename);
              } else {
                downloadLink.href = 'data:' + dataType + ', ' + tableHTML;
                downloadLink.download = filename;
                downloadLink.click();
              }

              document.body.removeChild(downloadLink);
            }

            document.querySelectorAll('.delete-user-form').forEach(form => {
              form.addEventListener('submit', function(e) {
                if (!confirm('هل أنت متأكد من حذف هذا المستخدم؟')) {
                  e.preventDefault();
                }
              });
            });
          </script>
        <% } else { %>
          <div class="alert alert-info">
            لا يوجد مستخدمين حتى الآن.
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
